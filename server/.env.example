PORT=4000

# AWS RDS Postgres — see CLAUDE.md for why RDS over a dev-focused host.
# Needs ?sslmode=require; uselibpqcompat=true is appended in code (lib/prisma.ts),
# not here — it breaks Prisma's own CLI tools if it's in this value.
DATABASE_URL=

# TMDB API
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# RAWG API (video games)
RAWG_API_KEY=

# MyAnimeList API (official) — get a Client ID at myanimelist.net/apiconfig
MAL_CLIENT_ID=

# Firebase Admin SDK — projectId/clientEmail/privateKey from a downloaded
# service account JSON (Firebase Console > Project Settings > Service
# Accounts). FIREBASE_PRIVATE_KEY keeps its literal "\n" sequences (don't
# convert to real newlines here) — firebaseAdmin.ts converts them at
# runtime, and most .env/Secret formats can't store real multi-line values
# in one key anyway.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
